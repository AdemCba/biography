# --- Brand (not decided yet; the site reads its name only from here) ---
NEXT_PUBLIC_SITE_NAME="Orbivida"
NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Locales live on the public site (subset of en,es,de,fr,pt). Each language version of a biography
# is gated on its own; hreflang only links versions that passed.
NEXT_PUBLIC_ENABLED_LOCALES="en,es,pt,de,fr"
NEXT_PUBLIC_CONTACT_EMAIL="editor@example.com"

# --- Ads & analytics (optional, leave empty until approved) ---
NEXT_PUBLIC_ADSENSE_CLIENT=""   # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GA_ID=""            # G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Fast indexing (used by scripts/indexnow.ts, normally from GitHub Actions) ---
# Any 8-128 char hex string; the build writes public/<key>.txt so search engines can verify it.
INDEXNOW_KEY=""
